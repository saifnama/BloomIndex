# BloomIndex environment configuration template.
# Copy this template to .env or .env.<profile> to configure the app:
#   cp .env.example .env

# Unified LLM Configuration (OpenAI SDK Chat Completions)
# Shared connection for RAG, NER, and RAGAS evaluation.
# Base URL must be a /v1 API root, not an operation endpoint or
# native Ollama path (/api/chat).
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   Ollama:       http://localhost:11434/v1
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Timeout for one LLM call, in seconds. Retry count for transient errors.
LLM_TIMEOUT_SECONDS=300.0
LLM_MAX_RETRIES=2

# Reasoning token controls.
# When LLM_THINKING=false, the app appends LLM_NO_THINK_DIRECTIVE to the
# prompt text. Use this for models with prompt-based reasoning control,
# such as Qwen. Set LLM_THINKING=true, or leave the directive empty, to
# allow reasoning output.
LLM_THINKING=false
LLM_NO_THINK_DIRECTIVE=/no_think

# Pass enable_thinking in extra_body for compatible runtimes such as
# llama.cpp or vLLM. Leave disabled for official OpenAI API endpoints.
# LLM_CHAT_TEMPLATE_KWARGS=true

# Context window of the target LLM. The retrieval token budget is the
# window minus reserve tokens.
LLM_CONTEXT_WINDOW=8192

# Qdrant Vector Database
# With QDRANT_URL set, the app uses server mode. Without it, the app
# uses embedded mode.
# Embedded mode stores data in QDRANT_DIR (defaults to tmp/qdrant).
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_DIR=

# Embedding
# One embedding model is active. If it fails to load, startup stops.
# There is no silent fallback. This prevents index vector mismatch.
# Common options:
#   BAAI/bge-small-en-v1.5: 33M params, ~130MB, fast evaluation default.
#   BAAI/bge-m3: 568M params, ~2GB, recommended production model.
#   Qwen/Qwen3-Embedding-4B: 4B params, high accuracy, requires GPU.
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Truncate the vector dimension for models with Matryoshka
# Representation Learning (MRL) support, such as Qwen3-Embedding.
# RAG_EMBEDDING_DIM=

# Custom query prefix instruction (for example, for asymmetric Qwen3
# retrieval).
# RAG_EMBEDDING_INSTRUCTION=

# Reranker
# Common options:
#   cross-encoder/ms-marco-MiniLM-L-6-v2: 22M params, lightweight.
#   BAAI/bge-reranker-v2-m3: 568M params, multilingual model.
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_FLASH_ATTENTION=false
RAG_MULTI_GPU=false

# Sub-batch size per forward pass. A higher value increases throughput.
# A lower value reduces peak GPU memory use. Candidate pool size for
# rerank.
# RAG_RERANK_BATCH_SIZE=8
# RAG_RERANK_CANDIDATE_K=40

# Target device override (auto-detects cuda, mps, or cpu when omitted).
# RAG_DEVICE=

# RAG Retrieval and Generation Tuning
RAG_TEMPERATURE=0.1
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.85
RAG_QUERY_TIMEOUT_SECONDS=180

# Citation mode: "fast" computes sentence attribution with cross-encoder
# scores. "llm_select" makes one extra LLM call.
# RAG_CITATION_MODE=fast

# Named Entity Recognition (NER)
# With NER_HYBRID=false, extraction runs dictionary-only matching.
# No LLM validation calls run.
NER_HYBRID=true
NER_CONFIDENCE_THRESHOLD=0.7
NER_CHUNK_WORDS=250
NER_MAX_CHUNKS=3
NER_UPLOAD_CHUNK_WORDS=600
NER_MAX_ATTEMPTS=2
NER_BUDGET_SECONDS=240.0

# Number of sections processed in parallel (1 = sequential execution).
# NER_CONCURRENCY=1
